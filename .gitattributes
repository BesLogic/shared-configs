# Set default behavior to automatically normalize line endings,
# and check out text files with LF on every OS (matches .editorconfig and dprint).
* text=auto eol=lf

# Shell scripts must be LF, or bash chokes on the CR (e.g. "$'\r': command not found").
*.in text eol=lf
*.sh text eol=lf

# Batch scripts must be CRLF, or cmd.exe can fail to find GOTO/CALL labels.
*.cmd text eol=crlf
*.bat text eol=crlf

# Set linguist-language to support comments syntax highlight in GitHub
*.json  linguist-language=jsonc
package.json  linguist-language=json
